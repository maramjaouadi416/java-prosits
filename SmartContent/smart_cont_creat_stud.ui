           <property name="styleSheet">
            <string notr="true">/* TABLE */
QTableView {
    font-family: &quot;Segoe UI&quot;, &quot;Roboto&quot;, &quot;Arial&quot;;
    font-size: 12pt;
    color: #1d1d1f;
    background: #f8f9fb;
    gridline-color: #e6e6e9;
    selection-background-color: #ffe08a;   /* jaune doux pour la sélection */
    selection-color: #1d1d1f;
    border: 1px solid #e6e6e9;
    border-radius: 10px;
    outline: 0;
    alternate-background-color: #ffffff;
}

QTableView::item {
    padding: 8px 14px;                    /* “hauteur de ligne” visuelle */
}

/* En-têtes type “pill” */
QHeaderView {
    background: transparent;
}

QHeaderView::section {
    background: #c79200;                  /* doré/moutarde */
    color: white;
    font-weight: 600;
    border: none;
    border-radius: 16px;                  /* bords arrondis type pill */
    padding: 8px 16px;
    margin-right: 8px;                    /* espace entre colonnes */
}

/* Coin en haut à gauche */
QTableCornerButton::section {
    background: #c79200;
    border: none;
    border-top-left-radius: 10px;
}

/* Lignes horizontales fines uniquement (look plus clean) */
QTableView::item:selected {
    background: #ffe08a;
    color: #1d1d1f;
}

/* Barres de défilement minimalistes (optionnel) */
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #d6d6da;
    min-height: 30px;
    min-width: 30px;
    border-radius: 6px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    background: transparent;
    border: none;
    width: 0; height: 0;
}
</string>
