          <property name="styleSheet">
           <string notr="true">/* === GroupBox cards (Sort Table / Export list) === */
QGroupBox {
    background-color: #e2e8f0;   /* fond gris clair */
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    padding: 12px;
}

/* === Labels inside GroupBoxes === */
QGroupBox QLabel {
    background-color: #e2e8f0;   /* même fond que le GroupBox */
    color: #475569;               /* texte gris */
    font-family: &quot;Segoe UI&quot;, Arial;
    font-size: 9pt;
    font-weight: 500;
}

/* === LineEdit with same background as GroupBox === */
QLineEdit {
    padding: 1px;
    border: 2px solid #555555;
    border-radius: 8px;
    background-color: #e2e8f0;   /* même fond que le GroupBox */
    color: #111111;
}
QDateEdit {
    border: 2px solid #000000;
    border-radius: 6px;
    padding: 6px;
    background: #e2e8f0;
    color: #222;
    font-weight: bold;
    selection-background-color: #b78603;
    selection-color: white;
}

QDateEdit:hover {
    border-color: #d4a017;
}

QDateEdit::drop-down {
    background: #b78603;
    width: 24px;
    border-radius: 0 6px 6px 0;
}

QDateEdit::down-arrow {
    image: none;
    width: 0;
    height: 0;
}
</string>
