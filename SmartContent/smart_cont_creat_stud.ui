          <property name="styleSheet">
           <string notr="true">/* === Add New Element Button === */
QPushButton#addBtn {
    background: #0ea5a8;             /* teal */
    color: #ffffff;
    border: 2px solid #089199;
    border-radius: 8px;
    height: 38px;
    font-family: &quot;Segoe UI&quot;, Arial;
    font-weight: 600;
    font-size: 10pt;
}
QPushButton#addBtn:hover {
    background: #089199;
}
QPushButton#addBtn:pressed {
    background: #067a82;
}

/* === GroupBox cards (Sort Table / Export list) === */
QGroupBox {
    background: #e2e8f0;             /* gray background like screenshot */
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    padding: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #0f172a;                  /* dark navy text */
    font-weight: 700;
    font-family: &quot;Segoe UI&quot;, Arial;
    font-size: 11pt;
}

/* === Labels inside GroupBoxes === */
QGroupBox QLabel {
    color: #475569;                  /* gray text inside */
    font-family: &quot;Segoe UI&quot;, Arial;
    font-size: 9pt;
    font-weight: 500;
}

/* === Small pill buttons (sort / export) === */
QPushButton#chipSort, QPushButton#chipExport {
    background: #1e293b;             /* dark navy pill */
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 4px 14px;
    font-weight: 600;
    font-family: &quot;Segoe UI&quot;, Arial;
    font-size: 9pt;
}
QPushButton#chipSort:hover, QPushButton#chipExport:hover {
    background: #334155;
}

/* === Frame background (container) === */
QFrame#leftPanel {
    background: #ffffff;
    border: none;
}
</string>
