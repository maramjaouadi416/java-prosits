           <property name="styleSheet">
            <string notr="true">QTableWidget{
    background:#ffffff;
    alternate-background-color:#f8fafc;
    border:none;
    gridline-color:transparent;
    selection-background-color:#fff9c4;
    selection-color:#000000;
    outline:none;
}

QHeaderView{background:transparent;}
QHeaderView::section{
    background:#b8860b; /* dark goldenrod / dark yellow */
    color:white;
    border:none;
    border-radius:12px;
    padding:6px 10px;
    margin:4px 6px;
    font-weight:600;
    font-family:Segoe UI,Arial;
}

QTableWidget::item{
    padding:8px 10px;
    border:none;
    font-family:Segoe UI,Arial;
    font-size:10.5pt;
}

/* Scrollbars */
QScrollBar:vertical{
    border:none;
    background:#f1f5f9;
    width:8px;
    border-radius:4px;
}
QScrollBar::handle:vertical{
    background:#c2a400; /* gold shade */
    border-radius:4px;
}
QScrollBar::handle:vertical:hover{
    background:#a17d00;
}
QScrollBar:horizontal{
    border:none;
    background:#f1f5f9;
    height:8px;
    border-radius:4px;
}
QScrollBar::handle:horizontal{
    background:#c2a400;
    border-radius:4px;
}
QScrollBar::handle:horizontal:hover{
    background:#a17d00;
}
</string>
