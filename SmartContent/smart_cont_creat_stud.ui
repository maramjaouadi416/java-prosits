    padding:8px 10px;
    border:none;
    font-family:Segoe UI,Arial;
    font-size:10.5pt;
}

/* Scrollbars */
QScrollBar:vertical{
    border:none;
    background:#f1f5f9;
    width:8px;
    border-radius:4px;
}
QScrollBar::handle:vertical{
    background:#c2a400; /* gold shade */
    border-radius:4px;
}
QScrollBar::handle:vertical:hover{
    background:#a17d00;
}
QScrollBar:horizontal{
    border:none;
    background:#f1f5f9;
    height:8px;
    border-radius:4px;
}
QScrollBar::handle:horizontal{
    background:#c2a400;
    border-radius:4px;
}
QScrollBar::handle:horizontal:hover{
    background:#a17d00;
}
